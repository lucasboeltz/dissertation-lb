  ;; -----------
  ;; definitions for universe elements:
  (declare-fun point!val!7 () point)
  (declare-fun point!val!6 () point)
  (declare-fun point!val!1 () point)
  (declare-fun point!val!0 () point)
  (declare-fun point!val!2 () point)
  (declare-fun point!val!5 () point)
  (declare-fun point!val!4 () point)
  (declare-fun point!val!3 () point)
  ;; cardinality constraint:
  (forall ((x point))
          (or (= x point!val!7)
              (= x point!val!6)
              (= x point!val!1)
              (= x point!val!0)
              (= x point!val!2)
              (= x point!val!5)
              (= x point!val!4)
              (= x point!val!3)))
  ;; -----------
  (define-fun Q604 () Bool
    (not (inside x1 w3 w2 x4)))
  (define-fun A3 () Bool
    (forall ((u point) (v point) (w point) (x point))
  (=> (and (left u v w) (left v u w) (left u x w)) (left u x v))))
  (define-fun T2 () Bool
    (forall ((u point) (v point) (w point) (x point))
  (=> (inside u v w x) (left v w x))))
