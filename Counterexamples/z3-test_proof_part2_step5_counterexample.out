  (=> (and (left u v w) (left v u w) (V w)) (not (F u v)))))
  (define-fun D14 () Bool
    (forall ((u point) (v point) (w point) (x point))
  (=> (and (intersection u v w x) (E u v) (F w x) (E u w) (E v w))
